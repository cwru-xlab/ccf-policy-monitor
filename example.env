# Copy to .env and fill in. Required keys have no default and the app will not start without them.

# Required. Postgres with the pgvector extension available, e.g. Supabase:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Bedrock credentials: a Bedrock API key (either name works), or standard AWS keys / profile.
# AWS_BEDROCK_API_KEY=
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION_NAME=us-east-1

# Optional. Bedrock region and model IDs (defaults shown).
# AWS_REGION=us-east-1
# BEDROCK_MODEL=us.anthropic.claude-opus-5-5   (criteria extraction)
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# COMPARISON_MODEL=us.anthropic.claude-opus-5-5

# Where raw source documents are written. Relative to the working directory.
# STORAGE_ROOT=data/objects

# Guideline source keys.
# openFDA: optional, raises the daily quota. https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
# NCBI E-utilities (PubMed): optional, 10 req/s instead of 3. https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
# USPSTF Prevention TaskForce: required for the uspstf source. Request from uspstfpda@ahrq.gov
USPSTF_API_KEY=

# Mapping engine. Firecrawl powers guideline discovery and update detection.
# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
# DISCOVERY_MODEL=us.anthropic.claude-opus-5-5
